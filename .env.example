# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# Remote, managed MongoDB (users, API keys, projects, collection stats/limits).
MONGODB_URI=mongodb+srv://user:password@host/admin?authSource=admin&tls=true
MONGODB_DB=recall_select

# Qdrant (vectors). Defaults target the internal compose network.
QDRANT_URL=http://qdrant:6333
# Shared secret between the app and the Qdrant server (compose sets Qdrant's
# QDRANT__SERVICE__API_KEY from this). Required in prod, where the dashboard is
# fronted at qdrant.recall.select and the key is its only gate. Leave blank for
# a local keyless Qdrant. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=
# Vector dimension for the Qdrant collections. The remote embedder is asked to
# return vectors of exactly this size (via the API's `dimensions` param), so this
# is the single knob that keeps the collection and the embeddings in sync.
VECTOR_SIZE=768

# Remote embedding API (text -> vector) - the only embedding backend.
EMBEDDING_API_KEY=
# Override to point at a different OpenAI-compatible embeddings API.
# EMBEDDING_BASE_URL=https://api.deepinfra.com/v1

# --- Auth (Google OAuth) + sessions ---------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (type: Web application). Authorized redirect URI must be
# {PUBLIC_BASE_URL}/auth/callback (e.g. http://localhost:8000/auth/callback
# for local dev, https://recall.select/auth/callback in prod).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret used to sign the session cookie. Generate one, keep it stable:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Public origin the app is served from - used to build the memory link and the
# OAuth redirect URI. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# --- Owner admin area (/admin) --------------------------------------------
# Lets you, the owner, open any user's personal area read-only: their plan,
# usage this period, projects and how many memories each holds, and their
# memory links in masked form. Memory *text* and key secrets are never shown.
#
# How to use it:
#   1. Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   2. Put it in ADMIN_SECRET below (server .env only - never commit it).
#   3. Recreate the web container so it picks the value up:
#        docker compose up -d web
#   4. Open {PUBLIC_BASE_URL}/admin, paste the key once, and you land on the
#      user list. Search by email, name, or user id; click a row for that
#      user's account view. "Lock" (top right) ends the admin session.
#
# Leave ADMIN_SECRET empty and the admin area does not exist: every /admin
# route answers 404, exactly like an unregistered URL. The key is submitted by
# POST form, never as a URL parameter, so it stays out of browser history and
# proxy access logs. Rotate it by changing the value here and recreating the
# container - any unlocked browser session is invalidated on the next request.
ADMIN_SECRET=
# How long an unlocked admin session lasts before it re-locks itself (hours).
ADMIN_SESSION_HOURS=12

# --- Payments (Monobank acquiring) ----------------------------------------
# recall.select reuses the SAME Monobank merchant as the mcp-api.net platform -
# only this token is shared. Invoices, redirect and webhook all belong to
# recall.select; funds land in the one merchant account, told apart by the
# invoice `reference`. Monobank -> Acquiring -> merchant X-Token.
MONOBANK_API_KEY=
# Optional overrides. Left blank, they default to {PUBLIC_BASE_URL}/payment/success
# and {PUBLIC_BASE_URL}/webhooks/monobank. The webhook URL must be publicly
# reachable for the tier to be granted (Monobank calls it server-to-server).
MONOBANK_REDIRECT_URL=
MONOBANK_WEBHOOK_URL=
# Verify the webhook's X-Sign signature against the merchant pubkey. Keep this on
# (default) anywhere real money moves; set to 0 ONLY for local dev, where the app
# can't reach Monobank to fetch the pubkey and no funds move.
MONOBANK_WEBHOOK_VERIFY=1
